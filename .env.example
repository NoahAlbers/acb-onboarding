# Copy to .env and fill in. NEVER commit .env.

# Public URL of the portal (used in signing redirects + notification emails)
BASE_URL=https://onboard.example.com
# Domain for Caddy's automatic HTTPS (docker-compose only)
DOMAIN=onboard.example.com

# Admin dashboard key for /admin — use something long and random:
#   openssl rand -hex 24
ADMIN_KEY=!GreatCollectors123?

# --- DocuSeal e-signing (recommended) ---
# With an API key set, clients sign through DocuSeal (legal audit trail).
# Without it, the portal falls back to its built-in draw/type signature.
DOCUSEAL_API_KEY=
# Defaults are DocuSeal cloud; point these at your instance if self-hosting:
# DOCUSEAL_API_URL=https://api.docuseal.com
# DOCUSEAL_SIGN_URL=https://docuseal.com/s
# Optional: protect the webhook endpoint (configure the same key in DocuSeal:
# Settings -> Webhooks -> URL: https://onboard.example.com/api/docuseal/webhook?key=...)
DOCUSEAL_WEBHOOK_KEY=
# Optional: add an ACB countersign step on every document
# ACB_SIGNER_EMAIL=

# --- Email (notifications, client copies, reminder emails) ---
# Any SMTP provider works: Google Workspace (create an app password), Microsoft 365,
# or a transactional service (Resend / Postmark / SES — use their SMTP endpoint).
# Manage recipients, attachments, and reminder cadence in /admin -> Email settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The From address clients see. With a transactional provider (Resend/Postmark/SES)
# this can be any address on your verified domain — no mailbox needed:
# MAIL_FROM=Advanced Collection Bureau <noreply-onboarding@advancedcb.com>
# Where replies to the noreply address should actually land:
# MAIL_REPLY_TO=nalbers@advancedcb.com

# --- Fallback completion emails to ACB when SMTP is not set (FormSubmit, same as acb-form) ---
# FORMSUBMIT_ID=dfeca48013a9d6519627f295dd99503c
# NOTIFY_ENABLED=true

# PORT=3000
# DATA_DIR=/data

# --- Lead console sync (optional) ---
# Reports onboarding milestones (portal opened, entities added, agreement
# signed, complete) back to the ACB lead console so the lead's timeline shows
# progress. Use the same key as ONBOARDING_WEBHOOK_KEY on the console.
# LEAD_CONSOLE_WEBHOOK_URL=https://www.advancedcb.app/api/webhooks/onboarding
# LEAD_CONSOLE_WEBHOOK_KEY=
